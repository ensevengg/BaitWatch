{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baitwatch.example/MANIFEST.schema.json",
  "title": "BaitWatch attack manifest",
  "description": "Ground truth for one generated attack repository. Labels only: payload text never appears in the manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repo", "title", "threat", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "threat": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "technique",
        "encoding",
        "expected_layer",
        "target",
        "payload_sha256"
      ],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "technique": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "expected_layer": { "enum": ["READ", "RUN", "both"] },
        "target": { "type": "string", "minLength": 1 },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decoded_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
